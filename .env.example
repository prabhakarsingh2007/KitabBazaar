# Django Core Settings
SECRET_KEY=your-production-secret-key-here-generate-a-strong-random-string
DEBUG=False
ALLOWED_HOSTS=.onrender.com,.railway.app,.herokuapp.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.railway.app,https://*.herokuapp.com

# Production PostgreSQL Database URL
DATABASE_URL=postgres://username:password@hostname:5432/dbname

# Razorpay Production / Test Key Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Security Settings (Optional, defaults to False for local testing, set True in HTTPS production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
